# Use the existing Restaurant schema and an account with SELECT/INSERT/UPDATE/DELETE.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=restaurant_demo
DB_PASSWORD=replace_with_your_password
DB_NAME=restaurant_praktikum
# Log SQL generated by SQLAlchemy. Parameters may appear in the teaching log.
SQL_ECHO=false
# Enable only for the local SQL injection demonstration on teaching data.
ALLOW_UNSAFE_SQL=false
FLASK_PORT=5000
